{
  "name": "@solocast/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend SoloCast (Fastify) : clé streameur, viewers anonymes, sessions Redis (WP1)",
  "type": "module",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "launch": "tsx src/launcher/main.ts",
    "bundle": "esbuild src/launcher/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/solocast.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\" --legal-comments=eof --metafile=dist/meta.json --define:process.env.SOLOCAST_VERSION=\\\"${SOLOCAST_VERSION:-dev}\\\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@fastify/websocket": "^11.3.4",
    "@solocast/shared": "workspace:*",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "livekit-server-sdk": "^2.19.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
  }
}
