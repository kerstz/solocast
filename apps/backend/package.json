{
  "name": "@solocast/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend SoloCast (Fastify) : clé streameur, viewers anonymes, sessions Redis (WP1)",
  "type": "module",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/websocket": "^8",
    "@solocast/shared": "workspace:*",
    "fastify": "^4.29.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "livekit-server-sdk": "^2.19.1",
    "ws": "^8",
    "zod": "^4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/ws": "^8",
    "tsx": "^4.23.15",
    "vitest": "^4.1.11"
  }
}
