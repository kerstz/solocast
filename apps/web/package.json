{
  "name": "@solocast/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend SoloCast : lecteur viewer + chat (Next.js App Router)",
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-3001}",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-3001}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:static": "NEXT_EXPORT=1 NEXT_DIST_DIR=out NEXT_PUBLIC_API_BASE_URL= NEXT_PUBLIC_WS_URL=/ws next build"
  },
  "dependencies": {
    "@solocast/shared": "workspace:*",
    "livekit-client": "^2.23.0",
    "next": "~16.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vitest": "^4.1.12"
  }
}
