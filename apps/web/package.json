{
  "name": "@solocast/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend SoloCast : lecteur viewer + chat (Next.js App Router)",
  "scripts": {
    "dev": "next dev -p ${WEB_PORT:-3001}",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-3001}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:static": "NEXT_EXPORT=1 NEXT_DIST_DIR=out NEXT_PUBLIC_API_BASE_URL= NEXT_PUBLIC_WS_URL=/ws next build"
  },
  "dependencies": {
    "@solocast/shared": "workspace:*",
    "livekit-client": "^2.22.3",
    "next": "~14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "vitest": "^4.1.11"
  }
}
