{
  "name": "solocast",
  "version": "0.2.0",
  "private": true,
  "description": "Plateforme de streaming mono-streameur SoloCast (monorepo)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @solocast/shared build && pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "launch": "pnpm --filter @solocast/shared build && pnpm --filter @solocast/web build:static && pnpm --filter @solocast/backend bundle && SOLOCAST_HOME=$PWD/apps/backend/dist node apps/backend/dist/solocast.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
