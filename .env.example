# =============================================================================
# SoloCast — variables d'environnement (MODÈLE)
# =============================================================================
# Copier vers .env (ignoré par Git) :   cp .env.example .env
# Toutes les valeurs ci-dessous sont des PLACEHOLDERS. Ne jamais committer de vraie valeur.
# Le backend refuse de démarrer tant qu'un secret commence par CHANGE_ME (config.ts, Zod).
#
# Règles :
#   - Générer les secrets :  openssl rand -hex 32   (évite les caractères spéciaux YAML/URL)
#   - Les variables NEXT_PUBLIC_* sont VISIBLES dans le navigateur : aucun secret dedans.
#     Elles vivent dans apps/web/.env.local (Next ne lit que le .env de son app).
#   - Compose lit ce fichier automatiquement (section 1). Le backend le charge via config.ts.
#   - Hôte vs Docker : depuis l'hôte (pnpm dev) on utilise localhost ; dans Docker, les noms de
#     service (redis, livekit, ingress).
#   - Ce fichier ne contient QUE des variables réellement lues par le code ou par Compose.

# -----------------------------------------------------------------------------
# 1. Infrastructure (lues par deploy/docker-compose.yml)
# -----------------------------------------------------------------------------

# Redis 7 (requirepass). Caractères alphanumériques recommandés (inséré dans une URL et du YAML).
REDIS_PASSWORD=CHANGE_ME_redis_password

# Clés API LiveKit. Côté serveur uniquement : JAMAIS envoyées au navigateur (seul le token signé l'est).
# LIVEKIT_API_SECRET : >= 32 caractères aléatoires.
LIVEKIT_API_KEY=CHANGE_ME_livekit_api_key
LIVEKIT_API_SECRET=CHANGE_ME_livekit_api_secret_min_32_chars

# IP annoncée aux clients WebRTC (ICE). Local : 127.0.0.1 (navigateur sur l'hôte) ou IP LAN de l'hôte
# (requise pour qu'Ingress, dans Docker, atteigne LiveKit). Prod : IP publique du VPS.
LIVEKIT_NODE_IP=127.0.0.1

# Webhooks LiveKit -> backend. Sans eux, le salon ne passe jamais « EN DIRECT » : c'est
# participant_joined (identité `streamer`) qui l'allume. Local : le backend tourne sur l'hôte.
# Dans Docker : http://backend:3000/webhooks/livekit
LIVEKIT_WEBHOOK_URL=http://host.docker.internal:3000/webhooks/livekit

# Adresses d'ingest annoncées aux streameurs OBS (renvoyées par POST /api/studio/ingest).
# Prod : rtmps://<domaine>:1935/x et https://<domaine>/w.
LIVEKIT_RTMP_BASE_URL=rtmp://localhost:1935/x
LIVEKIT_WHIP_BASE_URL=http://localhost:8085/w

# -----------------------------------------------------------------------------
# 2. Backend (Fastify) — apps/backend
# -----------------------------------------------------------------------------

NODE_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=3000
# debug | info | warn | error — prod : info (pas de logs verbeux, cf. §2.5)
LOG_LEVEL=info

# Où vit l'état éphémère (présence, bans, grants de parole, bail du studio) :
#   memory : tout dans le process. Suffisant en local, une seule instance backend.
#   redis  : état partagé. OBLIGATOIRE dès deux instances backend.
STATE_BACKEND=memory
# Requis seulement si STATE_BACKEND=redis. ioredis : mot de passe dans l'URL.
# Hôte = localhost (décommenter le port dans deploy/docker-compose.yml) ; dans Docker = redis.
# REDIS_URL=redis://:CHANGE_ME_redis_password@localhost:6379/0

# Signature HS256 des JWT de session (studio et viewer). Secret >= 32 octets.
JWT_SECRET=CHANGE_ME_jwt_secret_min_32_bytes
# Cookie studio (httpOnly, SameSite=Lax, 12 h) et cookie viewer (httpOnly, SameSite=Lax, session).
SESSION_COOKIE_NAME=sc_session
VIEWER_COOKIE_NAME=sc_viewer
# true en prod (HTTPS). false en dev HTTP local, sinon le cookie Secure n'est pas renvoyé.
# Obligatoire à true si NODE_ENV=production (validé par config.ts).
COOKIE_SECURE=false

# CORS : origine unique du front (allowlist, pas de '*'). Sert aussi d'allowlist d'origine
# pour l'upgrade WebSocket du chat.
CORS_ORIGIN=http://localhost:3001

# true derrière un reverse-proxy (Caddy, mode VPS) : Fastify lit X-Forwarded-For et le rate-limit
# compte la vraie IP du client. À laisser false en local (sinon une IP peut être usurpée).
TRUST_PROXY=false

# Accès au studio (qui l'ouvre peut diffuser, modérer et obtenir la clé de flux OBS).
#   key   (défaut) : POST /api/studio/open exige STUDIO_KEY, saisie dans la page /studio.
#   local : sans clé, réservé à cette machine. Refusé au démarrage si BACKEND_HOST n'est pas
#           loopback (127.0.0.1, ::1, localhost) ou si TRUST_PROXY=true.
# Dev local : STUDIO_ACCESS=local suffit. Docker (BACKEND_HOST=0.0.0.0) ou serveur : key.
STUDIO_ACCESS=local
# Requise si STUDIO_ACCESS=key : >= 32 octets aléatoires (openssl rand -hex 32).
# STUDIO_KEY=CHANGE_ME_studio_key_min_32_bytes
# Plafonne POST /api/studio/open (anti-force brute de la clé, anti-prise de place en boucle).
STUDIO_RATE_LIMIT_MAX=10
STUDIO_RATE_LIMIT_WINDOW_MS=60000

# Room LiveKit fixe V1. Doit valoir "main" (RoomNameSchema de @solocast/shared).
ROOM_NAME=main

# API serveur LiveKit (RoomService : createRoom, updateParticipant ; Ingress) — backend -> SFU.
# Dans Docker : http://livekit:7880
LIVEKIT_URL=http://localhost:7880
# URL WebSocket renvoyée au navigateur dans TokenResponse.livekitUrl (ws:// en local, wss:// en prod).
LIVEKIT_PUBLIC_WS_URL=ws://localhost:7880
# Durée de vie du token LiveKit, en secondes (60 à 3600).
LIVEKIT_TOKEN_TTL_SECONDS=600

# Parole : plafond de speakers WebRTC simultanés hors streameur (§2.5 : 8 max, plafond dur).
MAX_SPEAKERS=8

# Viewers simultanés acceptés dans le salon (chat + token LiveKit). Une place par viewerId :
# plusieurs onglets d'une même personne n'en consomment qu'une. Au-delà, la socket est fermée
# avec ROOM_FULL (4009) et POST /api/token répond 503. Le streameur n'occupe jamais de place.
MAX_VIEWERS=50

# Anti-abus de POST /api/token : chaque session SFU coûte de l'egress (§2.5).
TOKEN_RATE_LIMIT_MAX=10
TOKEN_RATE_LIMIT_WINDOW_MS=60000

# Chat : taille de l'historique renvoyé à la connexion, et rate-limit par viewerId.
CHAT_HISTORY_SIZE=200
# Rétention de l'historique du chat, en secondes (défaut 24 h, max 7 jours). En Redis, la liste
# reçoit un EXPIRE ; les messages plus anciens ne sont plus servis.
CHAT_HISTORY_TTL_SECONDS=86400
# Anti-abus du salon : sockets WebSocket viewer simultanées par IP (cette machine n'est pas
# plafonnée), et intervalle du heartbeat ping/pong (une socket muette est coupée, sa place libérée).
WS_MAX_CONNECTIONS_PER_IP=3
WS_HEARTBEAT_INTERVAL_MS=30000
# Un ban vise aussi l'empreinte HMAC de l'IP (jamais l'IP en clair), au plus pour cette durée
# (secondes, défaut 24 h, max 7 jours) : une IP peut être partagée (CGNAT, Wi-Fi public).
BAN_IP_TTL_SECONDS=86400
CHAT_RATE_LIMIT_MAX=3
CHAT_RATE_LIMIT_WINDOW_MS=2000
